    <Item class="Script" referent="RBXInventory1">
      <Properties>
        <string name="Name">Inventory</string>
        <ProtectedString name="Source">-- Private session inventory, roaming pens, growth, and automatic server-paid income.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Storage=game:GetService("ServerStorage")
local RunService=game:GetService("RunService")
local HttpService=game:GetService("HttpService")
local Income=require(script.Parent:WaitForChild("IncomeRules"))
local map=workspace:WaitForChild("SlimeMap")
local bases=map:WaitForChild("Bases")
local capture=script.Parent:WaitForChild("Capture")
local securedEvent=capture:WaitForChild("SlimeSecured")
local secured=Storage:WaitForChild("SecuredSlimes")
local remote=Instance.new("RemoteEvent",RS);remote.Name="SlimeInventory"
local displays=Instance.new("Folder",map);displays.Name="PlacedSlimes"
local GROW_SECONDS,CAPACITY,ACTION_INTERVAL=12,6,.15
local states,owners,lastAction={}, {}, {}
local random=Random.new()
local function notice(p,message) if p.Parent then remote:FireClient(p,"Message",message) end end
local function rate(state)
    local total=0
    for _,record in pairs(state.items) do if record.inPen then total+=Income.Rate(record.kind,record.weight) end end
    return total
end
local function settle(player,state)
    local now=os.clock()
    state.cash+=(now-state.lastPaid)*rate(state)
    state.lastPaid=now
    local earned=rate(state)
    player:SetAttribute("Cash",math.floor(state.cash*100+.0001)/100)
    player:SetAttribute("IncomePerSecond",earned)
    state.cashValue.Value=math.floor(state.cash)
end
local function snapshot(p)
    local state=states[p];if not state then return end
    local items={};local count=0
    for id,r in pairs(state.items) do
        if r.inPen then count+=1 end
        table.insert(items,{id=id,kind=r.kind,rarity=r.rarity,weight=r.weight,color=r.source.PrimaryPart.Color,
            inPen=r.inPen==true,progress=math.floor(r.progress*100+.0001)/100,rate=Income.Rate(r.kind,r.weight)})
    end
    table.sort(items,function(a,b)return a.id&lt;b.id end)
    remote:FireClient(p,"Snapshot",{items=items,selected=state.selected,base=state.base and state.base:GetAttribute("BaseIndex"),
        capacity=CAPACITY,placed=count,cash=state.cash,income=rate(state)})
end
-- Other server scripts can spend private cash without trusting a client balance.
local spend=Instance.new("BindableFunction")
spend.Name="TrySpendCash"
spend.OnInvoke=function(p,amount)
    local state=states[p]
    if not state or type(amount)~="number" or amount~=amount or amount&lt;=0 or amount==math.huge then return false end
    settle(p,state)
    if state.cash&lt;amount then return false end
    state.cash-=amount -- No yielding between checking and subtracting.
    settle(p,state);snapshot(p)
    return true
end
spend.Parent=script
local function showBaseName(base,p)
    for _,label in ipairs(base:GetDescendants()) do
        if label:IsA("TextLabel") then label.Text=p and (p.DisplayName.."'S PEN") or ("PEN 0"..base:GetAttribute("BaseIndex")) end
    end
end
local function claim(p)
    local state=states[p];if not state or state.base then return end
    local sorted=bases:GetChildren()
    table.sort(sorted,function(a,b)return a:GetAttribute("BaseIndex")&lt;b:GetAttribute("BaseIndex") end)
    for _,base in ipairs(sorted) do
        if not owners[base] then
            owners[base],state.base=p,base;base:SetAttribute("OwnerUserId",p.UserId)
            p:SetAttribute("BaseIndex",base:GetAttribute("BaseIndex"));showBaseName(base,p);snapshot(p);return
        end
    end
end
local function canUse(p,base)
    local state=states[p];local c=p.Character
    local root=c and c:FindFirstChild("HumanoidRootPart");local hum=c and c:FindFirstChildOfClass("Humanoid")
    if not state or not base or state.base~=base or owners[base]~=p or not root or not hum or hum.Health&lt;=0 then return false end
    local grass=base.PenGrass;local position=grass.CFrame:PointToObjectSpace(root.Position)
    return math.abs(position.X)&lt;=grass.Size.X*.5+4 and math.abs(position.Z)&lt;=grass.Size.Z*.5+4 and math.abs(position.Y)&lt;=12
end
local function bounds(state,r)
    local grass=state.base.PenGrass
    return grass.Position,grass.Size.X*.5-r.radius,grass.Size.Z*.5-r.radius
end
local function target(state,r)
    local center,hx,hz=bounds(state,r)
    local best,bestDistance
    for _=1,16 do
        local point=Vector3.new(center.X+random:NextNumber(-hx,hx),0,center.Z+random:NextNumber(-hz,hz))
        local distance=math.huge
        for _,other in pairs(state.items) do
            if other~=r and other.inPen and other.position then distance=math.min(distance,(point-other.position).Magnitude-other.radius-r.radius) end
        end
        if not bestDistance or distance&gt;bestDistance then best,bestDistance=point,distance end
        if distance&gt;1 then return point end
    end
    return best
end
local function updateDisplay(state,r)
    local scale=.65+(r.targetScale-.65)*r.progress
    r.display:ScaleTo(scale)
    local box,size=r.display:GetBoundingBox()
    local offset=r.display:GetPivot().Position.Y-(box.Position.Y-size.Y*.5)
    local grass=state.base.PenGrass
    local bounce=math.abs(math.sin(r.phase))*(r.moving and .28 or .035)
    r.display:PivotTo(CFrame.new(r.position.X,grass.Position.Y+grass.Size.Y*.5+.05+offset+bounce,r.position.Z)*r.rotation)
end
local function store(p,id)
    local state=states[p];local r=state and state.items[id]
    if not r or not r.inPen then return false end
    if not canUse(p,state.base) then notice(p,"Stand in your own pen to bring a slime back.");return false end
    settle(p,state);r.inPen=false
    if r.display then r.display:Destroy();r.display=nil end
    r.source:SetAttribute("GrowthProgress",r.progress)
    settle(p,state);snapshot(p);notice(p,"Returned to inventory. Stored slimes do not earn cash.")
    return true
end
local function place(p,id)
    local state=states[p];local r=state and state.items[id]
    if not r or r.inPen then return false end
    if not state.base then notice(p,"Waiting for an available pen.");return false end
    if not canUse(p,state.base) then notice(p,"Stand in your own pen to release a slime.");return false end
    local count=0;for _,other in pairs(state.items) do if other.inPen then count+=1 end end
    if count&gt;=CAPACITY then notice(p,"Your pen is full (6 slimes). Return one to inventory first.");return false end
    settle(p,state)
    local display=r.source:Clone()
    for _,item in ipairs(display:GetDescendants()) do
        if item:IsA("ProximityPrompt") or item:IsA("Beam") or item:IsA("WeldConstraint") then item:Destroy()
        elseif item:IsA("BasePart") then item.Anchored,item.CanCollide,item.CanTouch=true,false,false end
    end
    display:SetAttribute("Weight",nil);display:SetAttribute("GrowthProgress",nil);display:SetAttribute("CarrierUserId",nil)
    display:SetAttribute("OwnerUserId",p.UserId);display:SetAttribute("InventoryId",id)
    display.Name=r.kind.."Pen_"..string.sub(id,1,8)
    r.targetScale=.8+r.weight^(1/3)*.55
    local size=r.source:GetExtentsSize()
    -- Reserve adult-sized margins so a growing slime cannot poke through fences.
    r.radius=math.min(math.max(size.X,size.Z)*r.targetScale*.5+.8,11)
    r.display,r.inPen=display,true;r.position=target(state,r);r.goal=target(state,r)
    r.rotation=CFrame.identity;r.pauseUntil=0;r.phase=random:NextNumber(0,math.pi*2);r.blocked=0
    display.Parent=displays
    local prompt=Instance.new("ProximityPrompt",display.PrimaryPart)
    prompt.Name,prompt.ActionText,prompt.ObjectText="StoreSlime","Return to inventory",r.kind.." Slime"
    prompt.MaxActivationDistance,prompt.HoldDuration,prompt.RequiresLineOfSight=12,0,false
    prompt.Triggered:Connect(function(who)
        if who==p and who.Character and (who.Character:GetPivot().Position-display:GetPivot().Position).Magnitude&lt;=16 then store(who,id) end
    end)
    updateDisplay(state,r);settle(p,state);snapshot(p)
    notice(p,"Slime released! Cash is added automatically while it is in your pen.")
    return true
end
for _,base in ipairs(bases:GetChildren()) do
    -- Also migrate map geometry saved by previous versions.
    local pads=base:FindFirstChild("CollectionSpots");if pads then pads:Destroy() end
    base:SetAttribute("PenCapacity",CAPACITY)
    local anchor=Instance.new("Part")
    anchor.Name="PenEntrance";anchor.Size=Vector3.new(1,1,1)
    anchor.Position=base:GetAttribute("EntrancePosition")+Vector3.new(0,3,0)
    anchor.Anchored,anchor.Transparency,anchor.CanCollide,anchor.CanTouch,anchor.CanQuery=true,1,false,false,false
    anchor.Parent=base
    local prompt=Instance.new("ProximityPrompt",anchor)
    prompt.Name,prompt.ActionText,prompt.ObjectText="PenPrompt","Release selected slime","Slime pen"
    prompt.MaxActivationDistance,prompt.HoldDuration,prompt.RequiresLineOfSight=12,0,false
    prompt.Triggered:Connect(function(p)
        local state=states[p]
        if not state or state.base~=base then notice(p,"This is another player's pen.");return end
        if os.clock()-(lastAction[p] or -math.huge)&lt;ACTION_INTERVAL then return end
        lastAction[p]=os.clock()
        if state.selected then place(p,state.selected) else notice(p,"Open Slimes [I] and select a baby first.") end
    end)
end
local function add(p,source)
    local state=states[p];local folder=secured:FindFirstChild(tostring(p.UserId))
    if not state or not folder or source.Parent~=folder or not source.PrimaryPart then return end
    local id=source:GetAttribute("InventoryId");if id and state.items[id] then return end
    local weight=source:GetAttribute("Weight")
    if type(weight)~="number" or weight~=weight or weight&lt;=0 or weight==math.huge then return end
    id=HttpService:GenerateGUID(false);source:SetAttribute("InventoryId",id);source:SetAttribute("GrowthProgress",0)
    state.items[id]={source=source,weight=weight,kind=source:GetAttribute("SlimeType"),rarity=source:GetAttribute("Rarity"),progress=0}
    state.selected=state.selected or id;snapshot(p)
end
local function setup(p)
    if states[p] then return end
    local stats=p:FindFirstChild("leaderstats") or Instance.new("Folder",p);stats.Name="leaderstats"
    local cash=Instance.new("IntValue",stats);cash.Name="Cash"
    states[p]={items={},cash=0,lastPaid=os.clock(),cashValue=cash}
    settle(p,states[p]);claim(p)
    task.spawn(function()
        local folder=secured:WaitForChild(tostring(p.UserId),30)
        if folder and states[p] then for _,source in ipairs(folder:GetChildren()) do add(p,source) end end
    end)
end
securedEvent.Event:Connect(add)
Players.PlayerAdded:Connect(setup)
for _,p in ipairs(Players:GetPlayers()) do setup(p) end
Players.PlayerRemoving:Connect(function(p)
    local state=states[p];if not state then return end
    for _,r in pairs(state.items) do if r.display then r.display:Destroy() end end
    local base=state.base;states[p],lastAction[p]=nil,nil
    if base then
        owners[base]=nil;base:SetAttribute("OwnerUserId",nil);showBaseName(base,nil)
        for _,waiting in ipairs(Players:GetPlayers()) do if waiting~=p then claim(waiting) end end
    end
end)
remote.OnServerEvent:Connect(function(p,action,id)
    local state=states[p];if not state then return end
    if os.clock()-(lastAction[p] or -math.huge)&lt;ACTION_INTERVAL then return end
    lastAction[p]=os.clock()
    if action=="Request" then settle(p,state);snapshot(p);return end
    if type(id)~="string" or #id&gt;64 or not state.items[id] then return end
    if action=="Select" then state.selected=id;snapshot(p)
    elseif action=="Store" then store(p,id)
    elseif action=="Place" then place(p,id) end
end)
local elapsed,sendElapsed=0,0
RunService.Heartbeat:Connect(function(dt)
    elapsed+=dt;sendElapsed+=dt;if elapsed&lt;.1 then return end
    local step=elapsed;elapsed=0;local send=sendElapsed&gt;=1;if send then sendElapsed=0 end
    local now=os.clock()
    for p,state in pairs(states) do
        settle(p,state)
        for _,r in pairs(state.items) do
            if r.inPen then
                r.progress=math.min(1,r.progress+step/GROW_SECONDS);r.source:SetAttribute("GrowthProgress",r.progress)
                local delta=r.goal-r.position;r.moving=false
                if now&gt;=r.pauseUntil then
                    if delta.Magnitude&lt;.5 then
                        r.pauseUntil=now+random:NextNumber(.5,1.6);r.goal=target(state,r)
                    else
                        local candidate=r.position+delta.Unit*math.min(delta.Magnitude,2.6*math.min(step,.25))
                        local clear=true
                        for _,other in pairs(state.items) do
                            if other~=r and other.inPen and other.position and (candidate-other.position).Magnitude&lt;(r.radius+other.radius)*.8 then clear=false;break end
                        end
                        if clear then r.position=candidate;r.rotation=r.rotation:Lerp(CFrame.lookAt(Vector3.zero,-delta.Unit),.3);r.moving=true;r.blocked=0
                        else r.blocked+=step;if r.blocked&gt;1 then r.goal=target(state,r);r.blocked=0 end end
                    end
                end
                local center,hx,hz=bounds(state,r)
                r.position=Vector3.new(math.clamp(r.position.X,center.X-hx,center.X+hx),0,math.clamp(r.position.Z,center.Z-hz,center.Z+hz))
                r.phase+=step*(r.moving and 7 or 2);updateDisplay(state,r)
            end
        end
        if send then snapshot(p) end
    end
end)
print("Pens ready: roaming slimes, automatic income, no collection pads.")
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBXInventory2">
      <Properties>
        <string name="Name">IncomeRules</string>
        <ProtectedString name="Source">-- Server-only rates. Income is automatic for every placed slime, including growing babies.
local baseRates = {Grass=1,Mud=2,Water=4,Honey=8,Crystal=16,Gold=32}
local Rules = {}
function Rules.Rate(kind, weight)
    return math.floor((baseRates[kind] or 1) * weight^.6 * 100 + .5) / 100
end
return Rules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBXUpgrades1">
      <Properties>
        <string name="Name">Upgrades</string>
        <ProtectedString name="Source">-- ServerScriptService &gt; Upgrades. Prices and balances never come from the client.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Rules = require(script.Parent:WaitForChild("UpgradeRules"))
local spend = script.Parent:WaitForChild("Inventory"):WaitForChild("TrySpendCash")
local remote = Instance.new("RemoteEvent")
remote.Name, remote.Parent = "SlimeUpgrades", RS
local levels, lastAction = {}, {}
local function publish(player)
    local state = levels[player]
    player:SetAttribute("SpeedLevel", state.Speed)
    player:SetAttribute("GrabberLevel", state.Grabber)
    player:SetAttribute("GrabberPower", Rules.Power(state.Grabber))
end
local function snapshot(player, message)
    local state = levels[player]
    if not state then return end
    remote:FireClient(player, {
        speedLevel = state.Speed, grabberLevel = state.Grabber, maxLevel = Rules.MaxLevel,
        speedCost = Rules.Cost("Speed", state.Speed), grabberCost = Rules.Cost("Grabber", state.Grabber),
        speed = Rules.Speed(state.Speed), power = Rules.Power(state.Grabber),
        holdSeconds = Rules.HoldSeconds(state.Grabber), message = message,
    })
end
local function setup(player)
    if levels[player] then return end
    levels[player] = {Speed = 0, Grabber = 0}
    publish(player)
end
Players.PlayerAdded:Connect(setup)
Players.PlayerRemoving:Connect(function(player) levels[player], lastAction[player] = nil, nil end)
for _, player in ipairs(Players:GetPlayers()) do setup(player) end
remote.OnServerEvent:Connect(function(player, action, kind)
    if not levels[player] then return end
    local now = os.clock()
    if now - (lastAction[player] or -math.huge) &lt; 0.2 then return end
    lastAction[player] = now
    if action == "Request" then snapshot(player); return end
    if action ~= "Buy" or (kind ~= "Speed" and kind ~= "Grabber") then return end
    local state = levels[player]
    local cost = Rules.Cost(kind, state[kind])
    if not cost then snapshot(player, "Maximum level reached for now."); return end
    -- Inventory owns the private cash balance and subtracts the exact server price.
    if not spend:Invoke(player, cost) then snapshot(player, "Not enough cash. Release slimes into your pen to earn more."); return end
    state[kind] = state[kind] + 1
    publish(player)
    snapshot(player, (kind == "Speed" and "Speed" or "Grabber Power") .. " upgraded!")
end)
print("Upgrades ready: Speed and Grabber Power, five levels each, session-only.")
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBXUpgrades2">
      <Properties>
        <string name="Name">UpgradeRules</string>
        <ProtectedString name="Source">-- Server-only balance settings. Rebirths can raise these limits in a later feature.
local Rules = {MaxLevel = 5}
function Rules.Cost(kind, level)
    if (kind ~= "Speed" and kind ~= "Grabber") or level &lt; 0 or level &gt;= Rules.MaxLevel then return nil end
    return (kind == "Speed" and 25 or 35) * 2 ^ level
end
function Rules.Speed(level) return 16 + 2 * level end
function Rules.Power(level) return 10 + 2 * level end
function Rules.HoldSeconds(level) return 2 / (1 + 0.15 * level) end
function Rules.CarrySpeed(speedLevel, grabberLevel, weight, power)
    local penalty = 0.35 / (1 + 0.15 * grabberLevel)
    return math.max(6, Rules.Speed(speedLevel) * (1 - penalty * weight / math.max(1, power)))
end
return Rules
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBXUpgrades4">
      <Properties>
        <string name="Name">UpgradeIntegration</string>
        <ProtectedString name="Source">-- Isolated two-client upgrade checks; test controls never ship in the clean place.
local Players, RS, SS = game:GetService("Players"), game:GetService("ReplicatedStorage"), game:GetService("ServerScriptService")
local Storage = game:GetService("ServerStorage")
local Rules = require(SS:WaitForChild("UpgradeRules"))
local control = Instance.new("RemoteEvent", RS); control.Name = "UpgradeTestControl"
local ready, replies, seq, count = {}, {}, 0, 0
control.OnServerEvent:Connect(function(player, id, ok, result)
    if id == "Ready" then ready[player] = true else replies[id] = {player=player, ok=ok, result=result} end
end)
local function call(player, action, args)
    seq += 1; local id = tostring(seq)
    control:FireClient(player, id, action, args)
    local deadline = os.clock() + 12
    repeat task.wait(.03) until replies[id] or os.clock() &gt; deadline
    local reply = replies[id]
    assert(reply and reply.player == player and reply.ok, action .. ": " .. tostring(reply and reply.result))
    replies[id] = nil
    return reply.result
end
local function check(ok, text) assert(ok, text); count += 1; print("UPGRADE PASS: " .. text) end
local function at(player, point, toward)
    player.Character:PivotTo(toward and CFrame.lookAt(point, toward) or CFrame.new(point))
    player.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
    task.wait(.15)
end
local function run()
    local deadline = os.clock() + 120
    repeat task.wait(.2) until #Players:GetPlayers() &gt;= 2 or os.clock() &gt; deadline
    local a, b = table.unpack(Players:GetPlayers())
    repeat task.wait(.1) until ready[a] and ready[b] or os.clock() &gt; deadline
    assert(ready[a] and ready[b], "Need two ready clients")
    a.Character:WaitForChild("HumanoidRootPart"); b.Character:WaitForChild("HumanoidRootPart")
    local map = workspace.SlimeMap
    local initial = call(a, "Request")
    check(initial.speed == 16 and initial.power == 10 and initial.speedCost == 25 and initial.grabberCost == 35, "starting stats and prices")
    call(a, "Buy", {kind="Speed"})
    check(a:GetAttribute("SpeedLevel") == 0 and a:GetAttribute("Cash") == 0, "insufficient cash rejects without changing level")
    call(a, "FakeCash")
    check(a:GetAttribute("SpeedLevel") == 0 and a:GetAttribute("Cash") == 0, "client cash spoof cannot buy an upgrade")
    local spend = SS.Inventory.TrySpendCash
    for _, amount in ipairs({-1, 0, math.huge, 0/0}) do assert(not spend:Invoke(a, amount)) end
    check(true, "cash service rejects negative zero infinite and NaN amounts")
    -- Seed an earned, owned slime in private inventory, then use real pen release/income.
    local source = map.WildSlimes.GoldSlime:Clone()
    source:SetAttribute("Weight", 20); source.Parent = Storage.SecuredSlimes[tostring(a.UserId)]
    SS.Capture.SlimeSecured:Fire(a, source, 20); task.wait(.2)
    local id = source:GetAttribute("InventoryId")
    local pen = map.Bases["Base" .. a:GetAttribute("BaseIndex")]
    at(a, pen.PenGrass.Position + Vector3.new(0, 3, 0))
    call(a, "Inventory", {action="Place", id=id})
    repeat task.wait(.1) until a:GetAttribute("Cash") &gt;= 2200
    call(a, "Inventory", {action="Store", id=id})
    local balance = a:GetAttribute("Cash")
    check(balance &gt;= 2200 and a:GetAttribute("IncomePerSecond") == 0, "real pen income funds purchases; storing stops income")
    local snap = call(a, "Buy", {kind="Speed"})
    check(a:GetAttribute("Cash") == balance - 25 and a.leaderstats.Cash.Value == math.floor(balance - 25), "exact price deducted and leaderboard synchronized")
    check(snap.speedLevel == 1 and a.Character.Humanoid.WalkSpeed == 18, "Speed purchase applies immediately")
    check(snap.speedCost == 50 and b:GetAttribute("SpeedLevel") == 0 and b:GetAttribute("Cash") == 0, "next price increases and other player stays unchanged")
    balance = a:GetAttribute("Cash")
    call(a, "Invalid", {kind={name="Speed"}, userId=b.UserId})
    check(a:GetAttribute("Cash") == balance, "malformed upgrade request cannot spend cash")
    call(a, "Invalid", {kind="GrantCash"})
    check(a:GetAttribute("Cash") == balance, "unknown upgrade rejected")
    call(a, "Buy", {kind="Grabber"})
    check(a:GetAttribute("GrabberLevel") == 1 and a:GetAttribute("GrabberPower") == 12, "Grabber purchase increases power")
    -- Fixed server test target weight, without changing production random weight assignment.
    local baby = map.WildSlimes.GrassSlime
    baby:PivotTo(CFrame.new(0, 2, 85)); at(a, Vector3.new(0, 4, 90)); at(b, Vector3.new(0, 4, 170))
    local result = call(a, "Capture", {kind="GrassSlime", hold=.1})
    check(not a:GetAttribute("CarryingSlime"), "short holds still rejected with upgraded grabber")
    -- Upgrade to unlock every natural weight, then exercise the faster prompt.
    for _=2,5 do call(a, "Buy", {kind="Grabber"}) end
    check(a:GetAttribute("GrabberPower") == 20, "maximum grabber unlocks all starting weights")
    at(a, Vector3.new(0, 4, 110)); at(a, Vector3.new(0, 4, 90))
    result = call(a, "Capture", {kind="GrassSlime"})
    check(a:GetAttribute("CarryingSlime") == baby.Name and result.duration &lt; 1.2, "upgraded client hold bar and server timing capture faster")
    local before = a.Character.Humanoid.WalkSpeed
    call(a, "Buy", {kind="Speed"})
    check(a.Character.Humanoid.WalkSpeed &gt; before and a.Character.Humanoid.WalkSpeed &lt; 20, "Speed purchase while carrying preserves slowdown")
    SS.Capture.InterruptForBat:Invoke(a)
    check(a.Character.Humanoid.WalkSpeed == 20 and not a:GetAttribute("CarryingSlime"), "dropping restores upgraded walking speed")
    result = call(a, "Capture", {kind="GrassSlime", hold=0})
    check(a:GetAttribute("CarryingSlime") == baby.Name, "dropped pickup remains instant after upgrades")
    at(a, Vector3.new(0, 4, 126)); task.wait(.3)
    check(not a:GetAttribute("CarryingSlime") and a.Character.Humanoid.WalkSpeed == 20, "collection restores upgraded speed and still secures baby")
    -- Bat stun must remain zero during a purchase and restore the new level afterwards.
    at(a, Vector3.new(0, 4, 100)); at(b, Vector3.new(0, 4, 105), Vector3.new(0, 4, 100))
    call(b, "Bat")
    check(a.Character.Humanoid.WalkSpeed == 0, "bat stun still stops an upgraded player")
    call(a, "Buy", {kind="Speed"}); task.wait(.6)
    check(a.Character.Humanoid.WalkSpeed == 22, "stun restores the latest purchased speed")
    for _=4,5 do call(a, "Buy", {kind="Speed"}) end
    balance = a:GetAttribute("Cash")
    call(a, "Buy", {kind="Speed"}); call(a, "Buy", {kind="Grabber"})
    check(a:GetAttribute("SpeedLevel") == 5 and a:GetAttribute("GrabberLevel") == 5 and a:GetAttribute("Cash") == balance, "level caps reject extra purchases without charging")
    check(Rules.CarrySpeed(0,5,10,20) &gt; Rules.CarrySpeed(0,0,10,20), "grabber level reduces carrying penalty independently of power")
    local ui = call(a, "UI")
    check(ui.speedButton == "MAX LEVEL" and ui.powerButton == "MAX LEVEL" and ui.cash:find("Cash:"), "upgrade panel shows limits and current cash")
    a.Character.Humanoid.Health = 0
    local character = a.CharacterAdded:Wait(); character:WaitForChild("HumanoidRootPart"); task.wait(.5)
    check(character.Humanoid.WalkSpeed == 26 and a:GetAttribute("GrabberPower") == 20 and a:GetAttribute("Cash") == balance, "levels stats and cash survive character reset")
    check(b:GetAttribute("SpeedLevel") == 0 and b:GetAttribute("GrabberLevel") == 0, "purchases never change another player's levels")
    print("UPGRADE INTEGRATION COMPLETE: " .. count .. " checks")
end
task.spawn(function()
    local ok, err = xpcall(run, debug.traceback)
    if not ok then warn("UPGRADE INTEGRATION FAILED: " .. err) end
    pcall(function() game:GetService("StudioTestService"):EndTest({ok=ok,error=err,checks=count}) end)
end)
