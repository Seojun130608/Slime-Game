      <Item class="LocalScript" referent="RBXInventory3">
        <Properties>
          <string name="Name">InventoryUI</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local UIS=game:GetService("UserInputService")
local player=Players.LocalPlayer
local remote=RS:WaitForChild("SlimeInventory")
local state={items={}}
local currentDetail
local rarityColors={Common=Color3.fromRGB(182,191,180),Uncommon=Color3.fromRGB(107,226,69),Rare=Color3.fromRGB(57,187,255),Epic=Color3.fromRGB(190,116,255),Legendary=Color3.fromRGB(255,189,46)}
local gui=Instance.new("ScreenGui")
gui.Name,gui.ResetOnSpawn="SlimeInventoryUI",false
gui.Parent=player:WaitForChild("PlayerGui")
local function rounded(o,r) local c=Instance.new("UICorner",o);c.CornerRadius=UDim.new(0,r) end
local function border(o,color,width) local s=Instance.new("UIStroke",o);s.Color=color;s.Thickness=width;s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border end
local function label(parent,name,text,pos,size,fontSize)
    local l=Instance.new("TextLabel")
    l.Name,l.Text,l.Position,l.Size=name,text,pos,size
    l.BackgroundTransparency=1;l.Font=Enum.Font.GothamBold;l.TextSize=fontSize
    l.TextColor3=Color3.fromRGB(246,255,233);l.TextWrapped=true;l.Parent=parent
    return l
end
local function button(parent,name,text,pos,size,color)
    local b=Instance.new("TextButton")
    b.Name,b.Text,b.Position,b.Size=name,text,pos,size
    b.BackgroundColor3=color;b.Font=Enum.Font.GothamBlack;b.TextSize=17
    b.TextColor3=Color3.new(1,1,1);b.TextStrokeTransparency=.25;b.Parent=parent
    rounded(b,8);border(b,Color3.fromRGB(20,43,31),2)
    return b
end
local open=button(gui,"OpenInventory","SLIMES  [I]",UDim2.new(0,16,.48,0),UDim2.fromOffset(174,58),Color3.fromRGB(38,191,226))
local panel=Instance.new("Frame",gui)
panel.Name="Panel";panel.AnchorPoint=Vector2.new(.5,.5);panel.Position=UDim2.fromScale(.5,.48)
panel.Size=UDim2.fromOffset(890,590);panel.BackgroundColor3=Color3.fromRGB(35,63,47);panel.Visible=false
rounded(panel,14);border(panel,Color3.fromRGB(147,236,45),3)
local max=Instance.new("UISizeConstraint",panel);max.MaxSize=Vector2.new(890,590)
local title=label(panel,"Heading","YOUR SLIMES",UDim2.fromOffset(16,10),UDim2.new(1,-80,0,32),25)
title.TextXAlignment=Enum.TextXAlignment.Left
local close=button(panel,"Close","X",UDim2.new(1,-49,0,11),UDim2.fromOffset(34,32),Color3.fromRGB(237,84,97))
local instructions=label(panel,"Instructions","Select a slime and release it into your pen. Slimes wander and earn automatically. Hover or tap to inspect.",UDim2.fromOffset(16,49),UDim2.new(1,-32,0,39),13)
local list=Instance.new("ScrollingFrame",panel)
list.Name="Items";list.Position=UDim2.new(0,16,0,100);list.Size=UDim2.new(.61,-24,1,-116)
list.BackgroundColor3=Color3.fromRGB(26,48,37);list.BorderSizePixel=0;list.ScrollBarThickness=5
list.AutomaticCanvasSize=Enum.AutomaticSize.Y;list.CanvasSize=UDim2.new()
rounded(list,8)
local grid=Instance.new("UIGridLayout",list)
grid.CellSize=UDim2.new(.5,-7,0,150);grid.CellPadding=UDim2.fromOffset(6,8)
local padding=Instance.new("UIPadding",list);padding.PaddingTop=UDim.new(0,6);padding.PaddingLeft=UDim.new(0,5)
local info=Instance.new("Frame",panel)
info.Name="Details";info.BackgroundTransparency=1;info.Position=UDim2.new(.61,2,0,99);info.Size=UDim2.new(.39,-18,1,-112)
local base=label(info,"Base","ASSIGNING BASE...",UDim2.new(),UDim2.new(1,0,0,30),18)
local detail=label(info,"WeightDetails","Your secured babies appear here. Stored babies remain small until placed.",UDim2.fromOffset(0,39),UDim2.new(1,0,0,111),15)
local penCount=label(info,"PenCount","PEN 0 / 6",UDim2.fromOffset(0,153),UDim2.new(1,0,0,28),20)
local penIncome=label(info,"PenIncome","$0.00 / second",UDim2.fromOffset(0,186),UDim2.new(1,0,0,28),18)
local release=button(info,"Release","RELEASE INTO PEN",UDim2.fromOffset(0,232),UDim2.new(1,0,0,48),Color3.fromRGB(89,187,54))
local reclaim=button(info,"Reclaim","RETURN TO INVENTORY",UDim2.fromOffset(0,293),UDim2.new(1,0,0,48),Color3.fromRGB(38,170,215))
label(info,"PenHint","Stand inside your own pen to release or reclaim slimes. Cash is added automatically.",UDim2.fromOffset(0,356),UDim2.new(1,0,0,80),14)
release.Activated:Connect(function()
    if state.selected then remote:FireServer("Place",state.selected) end
end)
reclaim.Activated:Connect(function()
    if state.selected then remote:FireServer("Store",state.selected) end
end)
local cashHUD=label(gui,"CashHUD","$0",UDim2.new(0,18,1,-146),UDim2.fromOffset(300,38),30)
cashHUD.TextXAlignment=Enum.TextXAlignment.Left
cashHUD.TextColor3=Color3.fromRGB(135,255,54);cashHUD.TextStrokeTransparency=0
local rateHUD=label(gui,"RateHUD","+$0.00 / sec",UDim2.new(0,18,1,-109),UDim2.fromOffset(300,28),17)
rateHUD.TextXAlignment=Enum.TextXAlignment.Left;rateHUD.TextStrokeTransparency=0
local function updateCash()
    cashHUD.Text=string.format("$%.0f",player:GetAttribute("Cash") or 0)
    rateHUD.Text=string.format("+$%.2f / sec",player:GetAttribute("IncomePerSecond") or 0)
end
player:GetAttributeChangedSignal("Cash"):Connect(updateCash)
player:GetAttributeChangedSignal("IncomePerSecond"):Connect(updateCash)
updateCash()
local message=label(gui,"Notice","",UDim2.new(.15,0,.12,0),UDim2.new(.7,0,0,48),18)
message.BackgroundColor3=Color3.fromRGB(35,63,47);message.BackgroundTransparency=.08;message.Visible=false;rounded(message,10)
local function describe(item)
    currentDetail=item.id
    local status=item.inPen and (item.progress&gt;=1 and "Roaming in your pen" or "Growing in pen: "..math.floor(item.progress*100).."%")
        or (item.progress&gt;=1 and "Stored · Fully grown" or (item.progress&gt;0 and "Stored · Growth paused" or "Stored baby"))
    detail.Text=string.format("%s Slime\n%s · %.2f kg\n%s\n$%.2f / sec when in pen",item.kind,item.rarity,item.weight,status,item.rate or 0)
end
local function preview(card,item)
    local viewport=Instance.new("ViewportFrame",card)
    viewport.Position=UDim2.fromOffset(4,4);viewport.Size=UDim2.new(1,-8,0,87);viewport.BackgroundTransparency=1
    viewport.Ambient=Color3.fromRGB(210,220,210);viewport.LightColor=Color3.new(1,1,1)
    local model=Instance.new("WorldModel",viewport)
    local function ball(pos,size,color)
        local p=Instance.new("Part",model);p.Shape=Enum.PartType.Ball;p.Anchored=true
        p.Position,p.Size,p.Color=pos,size,color;p.Material=Enum.Material.SmoothPlastic
    end
    ball(Vector3.new(0,0,0),Vector3.new(4,3,4),item.color)
    for _,x in ipairs({-.65,.65}) do ball(Vector3.new(x,.55,-1.78),Vector3.new(.28,.4,.16),Color3.fromRGB(20,20,25)) end
    ball(Vector3.new(0,.15,-1.98),Vector3.new(.4,.18,.16),Color3.fromRGB(20,20,25))
    local camera=Instance.new("Camera",viewport)
    camera.CFrame=CFrame.lookAt(Vector3.new(0,2,-8),Vector3.zero);camera.FieldOfView=40;viewport.CurrentCamera=camera
end
local function render()
    local oldScroll=list.CanvasPosition
    for _,child in ipairs(list:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
    base.Text=state.base and ("YOUR PEN 0"..state.base) or "WAITING FOR A PEN"
    if #state.items==0 then
        local empty=label(list,"Empty","Capture a baby and bring it to the COLLECT ZONE.",UDim2.new(),UDim2.fromOffset(200,150),17)
        empty.LayoutOrder=0
    end
    local selectedInfo
    for i,item in ipairs(state.items) do
        local card=Instance.new("TextButton",list)
        card.Name="Item_"..item.id;card.Size=UDim2.fromOffset(170,150);card.Text=""
        card.BackgroundColor3=Color3.fromRGB(63,89,66);card.LayoutOrder=i;rounded(card,9)
        border(card,item.id==state.selected and Color3.fromRGB(179,255,60) or (rarityColors[item.rarity] or Color3.new(1,1,1)),item.id==state.selected and 3 or 2)
        preview(card,item)
        label(card,"SlimeName",item.kind,UDim2.fromOffset(4,91),UDim2.new(1,-8,0,20),16)
        local status=item.inPen and (item.progress&gt;=1 and "IN PEN" or "GROWING "..math.floor(item.progress*100).."%") or "IN INVENTORY"
        label(card,"Status",item.rarity.." · "..status,UDim2.fromOffset(4,116),UDim2.new(1,-8,0,28),10)
        card.MouseEnter:Connect(function() describe(item) end)
        card.Activated:Connect(function() describe(item);remote:FireServer("Select",item.id) end)
        if item.id==currentDetail then selectedInfo=item end
    end
    if selectedInfo then describe(selectedInfo) end
    penCount.Text=string.format("PEN %d / %d",state.placed or 0,state.capacity or 6)
    penIncome.Text=string.format("$%.2f / second",state.income or 0)
    local selected
    for _,item in ipairs(state.items) do if item.id==state.selected then selected=item;break end end
    release.Visible=selected~=nil and not selected.inPen
    reclaim.Visible=selected~=nil and selected.inPen
    list.CanvasPosition=oldScroll
end
local function toggle()
    panel.Visible=not panel.Visible
    if panel.Visible then render();remote:FireServer("Request") end
end
open.Activated:Connect(toggle)
close.Activated:Connect(function() panel.Visible=false end)
UIS.InputBegan:Connect(function(input,processed)
    if not processed and (input.KeyCode==Enum.KeyCode.I or input.KeyCode==Enum.KeyCode.ButtonY) then toggle() end
end)
local version=0
remote.OnClientEvent:Connect(function(kind,data)
    if kind=="Snapshot" then
        state=data
        open.Text="SLIMES ("..#state.items..")  [I]"
        if panel.Visible then render() end
    elseif kind=="Message" then
        version+=1;local this=version
        message.Text,message.Visible=data,true
        task.delay(3,function() if this==version then message.Visible=false end end)
    end
end)
remote:FireServer("Request")

local uiScale=Instance.new("UIScale",panel)
local viewportConnection
local function bindViewport()
    if viewportConnection then viewportConnection:Disconnect() end
    local camera=workspace.CurrentCamera
    if not camera then return end
    local function fit()
        local size=camera.ViewportSize
        uiScale.Scale=math.min(1,(size.X-24)/890,(size.Y*.78)/590)
    end
    viewportConnection=camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
    fit()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindViewport)
bindViewport()
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBXUpgrades3">
        <Properties>
          <string name="Name">UpgradesUI</string>
          <ProtectedString name="Source">-- StarterPlayerScripts &gt; UpgradesUI. Buttons request purchases; the server decides.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local CAS = game:GetService("ContextActionService")
local Prompts = game:GetService("ProximityPromptService")
local player = Players.LocalPlayer
local remote = RS:WaitForChild("SlimeUpgrades")
local state, pending = nil, false
local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn, gui.DisplayOrder = "SlimeUpgradesUI", false, 5
gui.Parent = player:WaitForChild("PlayerGui")
local function round(object)
    local corner = Instance.new("UICorner", object); corner.CornerRadius = UDim.new(0, 10)
end
local function label(parent, name, y, height, text, size)
    local object = Instance.new("TextLabel", parent)
    object.Name, object.Text = name, text
    object.Position, object.Size = UDim2.new(0, 16, 0, y), UDim2.new(1, -32, 0, height)
    object.BackgroundTransparency, object.TextWrapped = 1, true
    object.Font, object.TextSize, object.TextColor3 = Enum.Font.GothamBold, size, Color3.fromRGB(240, 255, 226)
    return object
end
local function button(parent, name, y, text)
    local object = Instance.new("TextButton", parent)
    object.Name, object.Text = name, text
    object.Position, object.Size = UDim2.new(0, 16, 0, y), UDim2.new(1, -32, 0, 44)
    object.BackgroundColor3, object.TextColor3 = Color3.fromRGB(101, 184, 63), Color3.new(1, 1, 1)
    object.Font, object.TextSize = Enum.Font.GothamBold, 17
    round(object)
    return object
end
local open = button(gui, "OpenUpgrades", 0, "UPGRADES [U]")
open.Position, open.Size = UDim2.new(0, 16, 0.48, -58), UDim2.fromOffset(174, 50)
local panel = Instance.new("Frame", gui)
panel.Name, panel.Visible, panel.AnchorPoint = "Panel", false, Vector2.new(0.5, 0.5)
panel.Position, panel.Size = UDim2.fromScale(0.5, 0.4), UDim2.new(0.9, 0, 0, 400)
panel.BackgroundColor3 = Color3.fromRGB(35, 63, 47); round(panel)
local bounds = Instance.new("UISizeConstraint", panel)
bounds.MaxSize = Vector2.new(510, 400)
label(panel, "Heading", 12, 32, "UPGRADES", 24)
local cash = label(panel, "Cash", 48, 28, "Cash: $0", 19)
local speed = label(panel, "Speed", 82, 42, "Loading...", 17)
local speedBuy = button(panel, "BuySpeed", 128, "Loading...")
local power = label(panel, "Grabber", 184, 48, "Loading...", 16)
local powerBuy = button(panel, "BuyGrabber", 237, "Loading...")
local notice = label(panel, "Notice", 287, 48, "Upgrades last this session. Saving comes later.", 14)
local close = button(panel, "Close", 345, "CLOSE")
local function update()
    local balance = player:GetAttribute("Cash") or 0
    cash.Text = string.format("Cash: $%.2f", balance)
    if not state then return end
    speed.Text = string.format("SPEED  %d / %d\nRun speed: %d", state.speedLevel, state.maxLevel, state.speed)
    power.Text = string.format("GRABBER POWER  %d / %d\nPower: %d  ·  Pull: %.2fs  ·  Less carrying slowdown", state.grabberLevel, state.maxLevel, state.power, state.holdSeconds)
    for _, item in ipairs({{speedBuy, state.speedCost}, {powerBuy, state.grabberCost}}) do
        local object, cost = item[1], item[2]
        object.Text = cost and ("BUY — $" .. cost) or "MAX LEVEL"
        object.Active = cost ~= nil and not pending
        object.AutoButtonColor = object.Active
        object.BackgroundColor3 = cost and balance &gt;= cost and Color3.fromRGB(101, 184, 63) or Color3.fromRGB(91, 105, 82)
    end
end
local function toggle()
    panel.Visible = not panel.Visible
    if panel.Visible then
        local inventory = player.PlayerGui:FindFirstChild("SlimeInventoryUI")
        if inventory then inventory.Panel.Visible = false end
        remote:FireServer("Request")
    end
end
open.Activated:Connect(toggle)
close.Activated:Connect(function() panel.Visible = false end)
CAS:BindAction("OpenSlimeUpgrades", function(_, input)
    if input == Enum.UserInputState.Begin then toggle() end
    return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.U)
local function buy(kind)
    if not state or pending or not (kind == "Speed" and state.speedCost or kind == "Grabber" and state.grabberCost) then return end
    pending = true; update()
    remote:FireServer("Buy", kind)
    task.delay(0.35, function() pending = false; update() end)
end
speedBuy.Activated:Connect(function() buy("Speed") end)
powerBuy.Activated:Connect(function() buy("Grabber") end)
remote.OnClientEvent:Connect(function(data)
    state, pending = data, false
    if data.message then notice.Text = data.message end
    update()
end)
player:GetAttributeChangedSignal("Cash"):Connect(update)
-- Only the local hold bar changes. Capture still measures the hold on the server.
local visible, holding = {}, {}
local function updatePrompt(prompt)
    if not holding[prompt] and prompt.Name == "CapturePrompt" and prompt.ActionText == "Pull with grabber" then
        prompt.HoldDuration = 2 / (1 + 0.15 * (player:GetAttribute("GrabberLevel") or 0))
    end
end
Prompts.PromptShown:Connect(function(prompt) visible[prompt] = true; updatePrompt(prompt) end)
Prompts.PromptHidden:Connect(function(prompt) visible[prompt], holding[prompt] = nil, nil end)
Prompts.PromptButtonHoldBegan:Connect(function(prompt) holding[prompt] = true end)
Prompts.PromptButtonHoldEnded:Connect(function(prompt) holding[prompt] = nil; updatePrompt(prompt) end)
player:GetAttributeChangedSignal("GrabberLevel"):Connect(function()
    for prompt in pairs(visible) do updatePrompt(prompt) end
end)
update(); remote:FireServer("Request")
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBXUpgrades5">
        <Properties>
          <string name="Name">UpgradeTestDriver</string>
          <ProtectedString name="Source">-- Included only in Upgrade-Test.rbxlx, never the playable place.
local Players, RS = game:GetService("Players"), game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local control = RS:WaitForChild("UpgradeTestControl")
local upgrades = RS:WaitForChild("SlimeUpgrades")
local inventory = RS:WaitForChild("SlimeInventory")
local latest, inv
upgrades.OnClientEvent:Connect(function(data) latest = data end)
inventory.OnClientEvent:Connect(function(kind, data) if kind == "Snapshot" then inv = data end end)
control.OnClientEvent:Connect(function(id, action, args)
    local ok, result = pcall(function()
        args = args or {}
        if action == "Buy" then upgrades:FireServer("Buy", args.kind); task.wait(.3); return latest
        elseif action == "Request" then upgrades:FireServer("Request"); task.wait(.3); return latest
        elseif action == "Invalid" then
            upgrades:FireServer("Buy", args.kind, -1000000, args.userId)
            task.wait(.3)
        elseif action == "FakeCash" then
            player:SetAttribute("Cash", 1e9); upgrades:FireServer("Buy", "Speed"); task.wait(.3)
        elseif action == "Inventory" then
            inventory:FireServer(args.action, args.id); task.wait(.3); return inv
        elseif action == "Capture" then
            local c = player.Character
            c.Humanoid:EquipTool(player.Backpack:FindFirstChild("Slime Grabber") or c:FindFirstChild("Slime Grabber"))
            task.wait(.2)
            local prompt = workspace.SlimeMap.WildSlimes[args.kind].Body.CapturePrompt
            -- Exercise the real client prompt duration, including the local upgraded bar.
            local duration = args.hold or prompt.HoldDuration
            prompt:InputHoldBegin(); task.wait(duration + .08); prompt:InputHoldEnd(); task.wait(.2)
            return {duration=prompt.HoldDuration, carrying=player:GetAttribute("CarryingSlime")}
        elseif action == "Bat" then
            local c = player.Character
            c.Humanoid:EquipTool(player.Backpack:FindFirstChild("Slime Bat") or c:FindFirstChild("Slime Bat"))
            RS.SlimeBatSwing:FireServer("Swing"); task.wait(.12)
        elseif action == "UI" then
            local gui = player.PlayerGui:WaitForChild("SlimeUpgradesUI", 5)
            gui.Panel.Visible = true
            upgrades:FireServer("Request"); task.wait(.3)
            return {speed=gui.Panel.Speed.Text, power=gui.Panel.Grabber.Text,
                cash=gui.Panel.Cash.Text, speedButton=gui.Panel.BuySpeed.Text, powerButton=gui.Panel.BuyGrabber.Text}
        end
        return true
    end)
    control:FireServer(id, ok, result)
end)
control:FireServer("Ready", true)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
