    <Item class="Script" referent="RBX9">
      <Properties>
        <string name="Name">Guardians</string>
        <ProtectedString name="Source">-- Roblox Luau: ServerScriptService &gt; Guardians.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local capture = script.Parent:WaitForChild("Capture")
local captured = capture:WaitForChild("SlimeCaptured")
local secured = capture:WaitForChild("SlimeSecured")
local released = capture:WaitForChild("SlimeReleased")
local caught = capture:WaitForChild("ParentCaught")
local map = workspace:WaitForChild("SlimeMap")
local slimes = map:WaitForChild("WildSlimes")
local trigger = map:WaitForChild("CollectZone"):WaitForChild("CollectionTrigger")
local safeZ = trigger.Position.Z - trigger.Size.Z / 2
local SPEED, GRACE, CATCH_DISTANCE = 14, 1.5, 6
local V = Vector3.new
local records = {}
local parents = Instance.new("Folder")
parents.Name, parents.Parent = "Guardians", map

-- PIECE 1: build a large parent with the baby's color and angry eyebrows.
local function part(name, size, color, frame, parent, ball)
    local p = Instance.new("Part")
    p.Name, p.Size, p.Color, p.CFrame = name, size, color, frame
    p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, false, false, false
    p.Material = Enum.Material.SmoothPlastic
    if ball then p.Shape = Enum.PartType.Ball end
    p.Parent = parent
    return p
end
local function register(slime)
    if records[slime] then return records[slime] end
    if not slime:IsA("Model") then return end
    slime:WaitForChild("Mouth")
    local body = slime.PrimaryPart
    if not body then return end
    local nest = map.Nests:FindFirstChild("Nest" .. tostring(slime:GetAttribute("NestIndex")))
    if not nest then return end
    local center = nest:GetAttribute("SpawnCenter")
    local side = body.Position.X &lt; center.X and -1 or 1
    local home = V(center.X + side * 9, 0, center.Z - 24)
    local model = Instance.new("Model")
    model.Name = slime:GetAttribute("SlimeType") .. "Parent"
    model:SetAttribute("SlimeType", slime:GetAttribute("SlimeType"))
    model:SetAttribute("State", "Idle")
    local root = part("Root", V(1, 1, 1), body.Color, CFrame.new(home), model)
    root.Transparency = 1
    model.PrimaryPart = root
    local skin = part("Body", V(14, 12, 14), body.Color, CFrame.new(home + V(0, 4.2, 0)), model, true)
    skin.Transparency = 0.06
    local black = Color3.fromRGB(25, 30, 24)
    for _, x in ipairs({-2.3, 2.3}) do
        part("Eye", V(0.9, 1.2, 0.45), black, CFrame.new(home + V(x, 5.5, -6.3)), model, true)
        part("AngryBrow", V(2.5, 0.5, 0.45), black,
            CFrame.new(home + V(x, 6.5, -6)) * CFrame.Angles(0, 0, math.rad(x &lt; 0 and -25 or 25)), model)
    end
    part("Mouth", V(2.3, 0.55, 0.4), black, CFrame.new(home + V(0, 3.6, -6.9)), model, true)
    model.Parent = parents
    local record = {
        slime = slime, model = model, home = home, position = home,
        rotation = CFrame.Angles(0, math.pi, 0), phase = 0,
        revision = 0, nextPath = 0, waypoints = {}, waypoint = 1,
    }
    records[slime] = record
    model:PivotTo(CFrame.new(home) * record.rotation)
    return record
end

-- PIECE 2: capture starts a chase; collection, release, or leaving ends it.
local function stop(record)
    local player = record.target
    if player and player:GetAttribute("ChasedBy") == record.model.Name then
        player:SetAttribute("ChasedBy", nil)
    end
    record.target, record.character = nil, nil
    record.revision = record.revision + 1
    record.waypoints, record.waypoint, record.nextPath = {}, 1, 0
    record.model:SetAttribute("State", "Returning")
    record.model:SetAttribute("TargetUserId", nil)
end
captured.Event:Connect(function(player, slime)
    local record = records[slime] or register(slime)
    if not record then return end
    if record.target then stop(record) end
    record.target, record.character = player, player.Character
    record.wakeAt = os.clock() + GRACE
    record.revision = record.revision + 1
    record.waypoints, record.waypoint, record.nextPath = {}, 1, 0
    record.model:SetAttribute("State", "Chasing")
    record.model:SetAttribute("TargetUserId", player.UserId)
    player:SetAttribute("ChasedBy", record.model.Name)
end)
local function endChase(_, slime)
    local record = records[slime]
    if record then stop(record) end
end
secured.Event:Connect(endChase)
released.Event:Connect(endChase)
Players.PlayerRemoving:Connect(function(player)
    for _, record in pairs(records) do
        if record.target == player then stop(record) end
    end
end)

-- PIECE 3: request paths without blocking the frame update.
-- A revision number prevents an old path from replacing a newer chase.
local obstacles = RaycastParams.new()
obstacles.FilterType = Enum.RaycastFilterType.Include
obstacles.FilterDescendantsInstances = {map.NurseryTunnel, map.Nests, map.BoundaryWalls}
local function clearStep(position, delta)
    for _, height in ipairs({3, 9}) do
        if workspace:Raycast(position + V(0, height, 0), delta, obstacles) then return false end
    end
    return true
end
local function requestPath(record, goal, now)
    if record.pathBusy or now &lt; record.nextPath then return end
    record.pathBusy, record.nextPath = true, now + 1
    local revision, start = record.revision, record.position
    task.spawn(function()
        local path = PathfindingService:CreatePath({AgentRadius = 7, AgentHeight = 11, AgentCanJump = false, WaypointSpacing = 5})
        local ok = pcall(function() path:ComputeAsync(start + V(0, 2, 0), goal + V(0, 2, 0)) end)
        record.pathBusy = false
        if record.revision ~= revision then return end
        if ok and path.Status == Enum.PathStatus.Success then
            local waypoints = path:GetWaypoints()
            local leavesCorridor = false
            for _, waypoint in ipairs(waypoints) do
                if math.abs(waypoint.Position.X) &gt; 40 or waypoint.Position.Z &gt; safeZ - 7 then
                    leavesCorridor = true
                    break
                end
            end
            -- The wide center lane gives large parents room around nursery roofs.
            if leavesCorridor then
                record.waypoints, record.waypoint = {{Position = V(0, 0, start.Z)}}, 1
            else
                record.waypoints, record.waypoint = waypoints, 2
            end
        else
            record.waypoints, record.waypoint = {}, 1
        end
    end)
end
local function tick(record, dt, now)
    local goal
    if record.target then
        local player, character = record.target, record.character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not player.Parent or player.Character ~= character or not root or not humanoid or humanoid.Health &lt;= 0
            or player:GetAttribute("CarryingSlime") ~= record.slime.Name or root.Position.Z &gt;= safeZ then
            stop(record)
        elseif now &gt;= record.wakeAt then
            local delta = root.Position - record.position
            local horizontal = V(delta.X, 0, delta.Z)
            if horizontal.Magnitude &lt;= CATCH_DISTANCE and math.abs(delta.Y) &lt; 12 then
                -- Check the line of sight before catching through an obstacle.
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = {character, parents, record.slime}
                if not workspace:Raycast(record.position + V(0, 4, 0), root.Position - (record.position + V(0, 4, 0)), params) then
                    caught:Fire(player, record.slime)
                    stop(record)
                else
                    goal = V(math.clamp(root.Position.X, -39, 39), 0, math.min(root.Position.Z, safeZ - 7))
                end
            else
                goal = V(math.clamp(root.Position.X, -39, 39), 0, math.min(root.Position.Z, safeZ - 7))
            end
        end
    end
    if not record.target and record.model:GetAttribute("State") == "Returning" then
        if (record.position - record.home).Magnitude &lt; 1.1 then
            record.position = record.home
            record.model:SetAttribute("State", "Idle")
        else
            goal = record.home
        end
    end
    local moved = false
    if goal then
        requestPath(record, goal, now)
        local waypoint = record.waypoints[record.waypoint]
        local destination = waypoint and V(waypoint.Position.X, 0, waypoint.Position.Z) or goal
        local delta = destination - record.position
        if delta.Magnitude &lt; 1 then
            record.waypoint = record.waypoint + 1
        else
            local step = delta.Unit * math.min(delta.Magnitude, SPEED * math.min(dt, 0.1))
            local nextPosition = record.position + step
            if nextPosition.Z &lt;= safeZ - 7 and math.abs(nextPosition.X) &lt;= 40 and clearStep(record.position, step) then
                record.position = nextPosition
                record.rotation = record.rotation:Lerp(CFrame.lookAt(V(0, 0, 0), delta.Unit), math.min(1, dt * 8))
                moved = true
            else
                record.nextPath = 0
            end
        end
    end
    record.phase = record.phase + dt * (moved and 8 or 2)
    local bounce = math.abs(math.sin(record.phase)) * (moved and 0.7 or 0.08)
    record.model:PivotTo(CFrame.new(record.position + V(0, bounce, 0)) * record.rotation)
end
slimes.ChildAdded:Connect(function(slime) task.spawn(register, slime) end)
for _, slime in ipairs(slimes:GetChildren()) do task.spawn(register, slime) end
RunService.Heartbeat:Connect(function(dt)
    local now = os.clock()
    for _, record in pairs(records) do tick(record, dt, now) end
end)
print("Guardians ready: giant parents chase captured babies and stop at the collect zone.")
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX10">
      <Properties>
        <string name="Name">Bat</string>
        <ProtectedString name="Source">-- Slime Bat: clients request swings; the server decides range, safety and the hit.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPack = game:GetService("StarterPack")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Rules = require(script.Parent:WaitForChild("CombatRules"))
local interrupt = script.Parent:WaitForChild("Capture"):WaitForChild("InterruptForBat")
local remote = Instance.new("RemoteEvent")
remote.Name, remote.Parent = "SlimeBatSwing", ReplicatedStorage
local lastSwing, stuns = {}, {}
local tool = Instance.new("Tool")
tool.Name, tool.CanBeDropped = "Slime Bat", false
tool.ToolTip = "Knock back a rival and drop their baby. Bases are safe."
tool.Grip = CFrame.new(0, -0.8, 0)
local function part(name, size, offset, color)
    local p = Instance.new("Part")
    p.Name, p.Size, p.CFrame, p.Color = name, size, CFrame.new(offset), color
    p.Material, p.CanCollide, p.CanTouch, p.Massless = Enum.Material.SmoothPlastic, false, false, true
    p.Parent = tool
    return p
end
local handle = part("Handle", Vector3.new(.38, 1.4, .38), Vector3.zero, Color3.fromRGB(62,69,89))
local barrel = part("PaddedHead", Vector3.new(1.1, 3, 1.1), Vector3.new(0, 2, 0), Color3.fromRGB(70,218,255))
local cap = part("EndCap", Vector3.new(1.15,.22,1.15), Vector3.new(0,3.55,0), Color3.fromRGB(166,255,49))
for _, p in ipairs({barrel, cap}) do
    local weld = Instance.new("WeldConstraint")
    weld.Part0, weld.Part1, weld.Parent = handle, p, handle
end
tool.Parent = StarterPack
local function getLiving(player)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if root and hum and hum.Health &gt; 0 then return character, root, hum end
end
local function feedback(player, text)
    remote:FireClient(player, "Message", text)
end
local function animate(bat)
    local rest = CFrame.new(0, -.8, 0)
    local forward = TweenService:Create(bat, TweenInfo.new(.10), {Grip = rest * CFrame.Angles(0, 0, math.rad(-95))})
    forward:Play()
    task.delay(.12, function()
        if bat.Parent then TweenService:Create(bat, TweenInfo.new(.16), {Grip = rest}):Play() end
    end)
end
local function knockback(player, root, humanoid, attackerRoot)
    local now = workspace:GetServerTimeNow()
    player:SetAttribute("BatProtectedUntil", now + Rules.HitProtection)
    player:SetAttribute("BatStunnedUntil", now + Rules.StunDuration)
    local record = {humanoid = humanoid, speed = humanoid.WalkSpeed, rotate = humanoid.AutoRotate}
    stuns[player] = record
    humanoid.WalkSpeed, humanoid.AutoRotate = 0, false
    local delta = root.Position - attackerRoot.Position
    local flat = Vector3.new(delta.X, 0, delta.Z)
    local direction = flat.Magnitude &gt; .01 and flat.Unit or attackerRoot.CFrame.LookVector
    -- Server owns the short impact, so a client cannot suppress it.
    local canOwn = root:CanSetNetworkOwnership()
    if canOwn then root:SetNetworkOwner(nil) end
    root:ApplyImpulse((direction * Rules.Knockback + Vector3.new(0,12,0)) * root.AssemblyMass)
    local glow = Instance.new("Highlight")
    glow.Name, glow.Adornee = "BatProtection", player.Character
    glow.FillColor, glow.OutlineColor = Color3.fromRGB(132,239,255), Color3.new(1,1,1)
    glow.FillTransparency, glow.OutlineTransparency = .8, .25
    glow.Parent = player.Character
    Debris:AddItem(glow, Rules.HitProtection)
    task.delay(Rules.StunDuration, function()
        if stuns[player] ~= record then return end
        stuns[player] = nil
        if humanoid.Parent and humanoid.Health &gt; 0 then
            humanoid.WalkSpeed, humanoid.AutoRotate = record.speed, record.rotate
        end
        if root.Parent and canOwn then root:SetNetworkOwnershipAuto() end
    end)
end
local function clearLine(a, b, attacker, target)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = {attacker, target}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(excluded, p.Character) end
    end
    local map = workspace:FindFirstChild("SlimeMap")
    if map then
        if map:FindFirstChild("WildSlimes") then table.insert(excluded, map.WildSlimes) end
        if map:FindFirstChild("Guardians") then table.insert(excluded, map.Guardians) end
    end
    params.FilterDescendantsInstances = excluded
    return not workspace:Raycast(a, b - a, params)
end
local function swing(player)
    local character, root = getLiving(player)
    if not character then return end
    local bat = character:FindFirstChild(tool.Name)
    if not bat or not bat:IsA("Tool") or not bat:FindFirstChild("PaddedHead") then return end
    local now = workspace:GetServerTimeNow()
    if Rules.IsStunned(player) then return end
    if now - (lastSwing[player] or -math.huge) &lt; Rules.SwingCooldown then return end
    -- Rate limit rejected attempts as well as accepted swings.
    lastSwing[player] = now
    if player:GetAttribute("CarryingSlime") then feedback(player, "Put down your baby before swinging."); return end
    if Rules.IsSafe(character) then feedback(player, "Bases and the collect zone are safe."); return end
    animate(bat)
    local nearest, distance
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local c, r, h = getLiving(other)
            if c and not Rules.IsSafe(c) and (other:GetAttribute("BatProtectedUntil") or 0) &lt;= now then
                local delta = r.Position - root.Position
                local d = delta.Magnitude
                -- A short forward arc, never a hit behind the attacker or through a wall.
                if d &lt;= Rules.Range and (d &lt; .01 or root.CFrame.LookVector:Dot(delta.Unit) &gt;= .15)
                    and clearLine(root.Position, r.Position, character, c)
                    and (not distance or d &lt; distance) then
                    nearest, distance = {player = other, root = r, humanoid = h}, d
                end
            end
        end
    end
    if nearest then
        -- Drop before stun, so capture restores the normal walking speed first.
        nearest.player:SetAttribute("BatProtectedUntil", now + Rules.HitProtection)
        nearest.player:SetAttribute("BatStunnedUntil", now + Rules.StunDuration)
        local dropped = interrupt:Invoke(nearest.player)
        knockback(nearest.player, nearest.root, nearest.humanoid, root)
        feedback(player, dropped and "Hit! Their baby is on the ground." or "Hit!")
        feedback(nearest.player, dropped and "Baby dropped! Equip your grabber to recover it." or "Hit! You have two seconds of protection.")
    end
end
remote.OnServerEvent:Connect(function(player, action)
    if action == "Drop" then
        local character = getLiving(player)
        if character and player:GetAttribute("CarryingSlime") and not Rules.IsStunned(player) and not Rules.IsSafe(character) then
            interrupt:Invoke(player)
        end
    elseif action == nil or action == "Swing" then
        swing(player)
    end
end)
local function setup(player)
    local function characterAdded(character)
        stuns[player] = nil
        player:SetAttribute("BatStunnedUntil", nil)
        player:SetAttribute("BatProtectedUntil", nil)
        local backpack = player:WaitForChild("Backpack")
        if player.Character == character and not backpack:FindFirstChild(tool.Name) and not character:FindFirstChild(tool.Name) then
            tool:Clone().Parent = backpack
        end
    end
    player.CharacterAdded:Connect(characterAdded)
    if player.Character then task.spawn(characterAdded, player.Character) end
end
Players.PlayerAdded:Connect(setup)
Players.PlayerRemoving:Connect(function(player) lastSwing[player], stuns[player] = nil, nil end)
for _, player in ipairs(Players:GetPlayers()) do setup(player) end
print("Slime Bat ready: 0.9s swings, 2s protection, safe bases, shared dropped babies.")
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX14">
      <Properties>
        <string name="Name">BatIntegration</string>
        <ProtectedString name="Source">-- Isolated 2-player integration suite. Not packaged in the playable build.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local SS=game:GetService("ServerScriptService")
local control=Instance.new("RemoteEvent",RS);control.Name="BatTestControl"
local ready,answers={},{}
control.OnServerEvent:Connect(function(p,id,ok,err)
    if id=="Ready" then ready[p]=true else answers[id]={p=p,ok=ok,err=err} end
end)
local sequence=0
local function action(p,name,arg)
    sequence+=1;local id=tostring(sequence)
    control:FireClient(p,id,name,arg)
    local endAt=os.clock()+9
    repeat task.wait(.03) until answers[id] or os.clock()&gt;endAt
    local reply=answers[id];assert(reply and reply.p==p and reply.ok,"Client action "..name..": "..tostring(reply and reply.err))
    answers[id]=nil
end
local function place(p,pos,look)
    p.Character:PivotTo(CFrame.lookAt(pos,look or pos+Vector3.new(0,0,-1)))
    p.Character.HumanoidRootPart.AssemblyLinearVelocity=Vector3.zero
end
local function check(ok,name) assert(ok,name);print("BAT PASS: "..name) end
local function run()
    local deadline=os.clock()+120
    repeat task.wait(.2) until #Players:GetPlayers()&gt;=2 or os.clock()&gt;deadline
    assert(#Players:GetPlayers()&gt;=2,"Start Server and Clients with 2 players")
    local a,b=table.unpack(Players:GetPlayers())
    repeat task.wait(.1) until ready[a] and ready[b] or os.clock()&gt;deadline
    assert(ready[a] and ready[b],"Clients not ready")
    for _,p in ipairs({a,b}) do
        p.Character:WaitForChild("HumanoidRootPart")
        p.Backpack:WaitForChild("Slime Bat");p.Backpack:WaitForChild("Slime Grabber")
        p:SetAttribute("GrabberPower",20)
    end
    local capture=SS:WaitForChild("Capture");capture:WaitForChild("InterruptForBat")
    local rules=require(SS.CombatRules)
    local map=workspace:WaitForChild("SlimeMap")
    local slime=map.WildSlimes:WaitForChild("GrassSlime")
    local prompt=slime.Body:WaitForChild("CapturePrompt")
    local function resetCombat()
        task.wait(1)
        for _,p in ipairs({a,b}) do p:SetAttribute("BatProtectedUntil",nil);p:SetAttribute("BatStunnedUntil",nil) end
    end
    place(a,Vector3.new(0,4,180));place(b,Vector3.new(0,4,175))
    action(a,"Bat");check(not b:GetAttribute("BatProtectedUntil"),"safe-zone attacker cannot hit")
    resetCombat();place(a,Vector3.new(0,4,121),Vector3.new(0,4,130));place(b,Vector3.new(0,4,126))
    action(a,"Bat");check(not b:GetAttribute("BatProtectedUntil"),"safe-zone victim cannot be hit across boundary")
    resetCombat();place(a,Vector3.new(0,4,90));place(b,Vector3.new(0,4,70))
    action(a,"Bat");check(not b:GetAttribute("BatProtectedUntil"),"out-of-range swing misses")
    resetCombat();place(a,Vector3.new(0,4,90));place(b,Vector3.new(0,4,95))
    action(a,"Bat");check(not b:GetAttribute("BatProtectedUntil"),"swing cannot hit behind attacker")
    resetCombat();place(a,Vector3.new(0,4,90));place(b,Vector3.new(0,4,85))
    local wall=Instance.new("Part",workspace);wall.Anchored=true;wall.Size=Vector3.new(10,10,1);wall.Position=Vector3.new(0,5,87.5)
    action(a,"Bat");check(not b:GetAttribute("BatProtectedUntil"),"wall blocks hit");wall:Destroy()
    resetCombat();place(a,Vector3.new(0,4,90));place(b,Vector3.new(0,4,85))
    local health=b.Character.Humanoid.Health
    action(a,"Bat");check((b:GetAttribute("BatProtectedUntil") or 0)&gt;workspace:GetServerTimeNow(),"valid forward hit gives protection")
    check(b.Character.Humanoid.Health==health,"bat deals no health damage")
    local expiry=b:GetAttribute("BatProtectedUntil")
    place(b,Vector3.new(0,4,85));action(a,"Swing")
    check(b:GetAttribute("BatProtectedUntil")==expiry,"rapid repeated swing is rejected")
    task.wait(.75);place(b,Vector3.new(0,4,85));action(a,"Swing")
    check(b:GetAttribute("BatProtectedUntil")==expiry,"protection prevents another hit after swing cooldown")
    task.wait(.65);check(b.Character.Humanoid.WalkSpeed==16,"walking speed restored after impact")
    resetCombat();place(a,Vector3.new(0,4,90));place(b,Vector3.new(0,4,85));action(a,"Unequip");action(a,"Swing")
    check(not b:GetAttribute("BatProtectedUntil"),"unequipped remote cannot hit")
    -- Move a baby to the clear lane; its original nursery/home are retained.
    slime:PivotTo(CFrame.new(0,2,80))
    place(b,Vector3.new(0,4,85));place(a,Vector3.new(0,4,92))
    action(b,"Begin","GrassSlime");action(a,"Bat")
    check(not slime.Body:FindFirstChildOfClass("Beam"),"hit breaks active capture tether")
    task.wait(2.1);action(b,"Release","GrassSlime")
    check(not slime:GetAttribute("Captured"),"interrupted pull cannot finish")
    resetCombat();slime:PivotTo(CFrame.new(0,2,80));place(b,Vector3.new(0,4,85));place(a,Vector3.new(0,4,108))
    action(b,"Capture","GrassSlime")
    check(b:GetAttribute("CarryingSlime")=="GrassSlime","normal capture works")
    place(a,Vector3.new(0,4,92));place(b,Vector3.new(0,4,87))
    action(a,"Bat")
    check(not b:GetAttribute("CarryingSlime") and not slime:GetAttribute("Captured"),"hit drops carried baby")
    check(prompt.Enabled and prompt.HoldDuration==0,"dropped baby has instant pickup prompt")
    task.wait(.1);check(not b:GetAttribute("ChasedBy"),"drop ends original parent chase")
    place(a,slime.Body.Position+Vector3.new(0,3,4));action(a,"Pickup","GrassSlime")
    check(a:GetAttribute("CarryingSlime")=="GrassSlime","another player can claim dropped baby")
    task.wait(.1);check(a:GetAttribute("ChasedBy")=="GrassParent","parent retargets new carrier")
    place(b,Vector3.new(0,4,110));place(a,Vector3.new(0,4,105),Vector3.new(0,4,110));resetCombat();action(a,"Bat")
    check(not b:GetAttribute("BatProtectedUntil"),"carrying player cannot swing")
    action(a,"Drop");check(not a:GetAttribute("CarryingSlime"),"voluntary drop works")
    place(a,slime.Body.Position+Vector3.new(0,3,4));action(a,"Pickup","GrassSlime")
    check(a:GetAttribute("CarryingSlime")=="GrassSlime","original carrier can recover a drop")
    place(a,Vector3.new(0,4,126));task.wait(.5)
    check(a:GetAttribute("CollectedSlimes")==1,"stolen drop secures exactly once")
    local secured=game.ServerStorage.SecuredSlimes:FindFirstChild(tostring(a.UserId))
    local baby=secured and secured:FindFirstChild("GrassSlime")
    check(baby and type(baby:GetAttribute("Weight"))=="number","secured drop retains hidden weight")
    print("BAT INTEGRATION COMPLETE")
end
task.spawn(function()
    local ok,err=xpcall(run,debug.traceback)
    if not ok then warn("BAT INTEGRATION FAILED: "..err) end
    pcall(function() game:GetService("StudioTestService"):EndTest({ok=ok,error=err}) end)
end)
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX11">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX12">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX13">
        <Properties>
          <string name="Name">BatInput</string>
          <ProtectedString name="Source">-- StarterPlayerScripts: standard tool activation supports mouse, touch and controller.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild("SlimeBatSwing")
local connected = setmetatable({}, {__mode = "k"})
local function watch(tool)
    if not tool:IsA("Tool") or tool.Name ~= "Slime Bat" or connected[tool] then return end
    connected[tool] = true
    tool.Activated:Connect(function() remote:FireServer() end)
end
local function characterAdded(character)
    character.ChildAdded:Connect(watch)
    for _, tool in ipairs(character:GetChildren()) do watch(tool) end
end
player.CharacterAdded:Connect(characterAdded)
if player.Character then characterAdded(player.Character) end
local gui = Instance.new("ScreenGui")
gui.Name, gui.ResetOnSpawn = "BatFeedback", false
gui.Parent = player:WaitForChild("PlayerGui")
local label = Instance.new("TextLabel")
label.AnchorPoint = Vector2.new(.5, 0)
label.Position, label.Size = UDim2.new(.5,0,.18,0), UDim2.new(.8,0,0,48)
label.BackgroundColor3, label.BackgroundTransparency = Color3.fromRGB(25,65,52), .1
label.TextColor3, label.TextSize, label.Font = Color3.new(1,1,1), 20, Enum.Font.GothamBold
label.TextWrapped, label.Visible, label.Parent = true, false, gui
Instance.new("UICorner", label).CornerRadius = UDim.new(0,10)
local version = 0
remote.OnClientEvent:Connect(function(kind, message)
    if kind ~= "Message" then return end
    version += 1
    local current = version
    label.Text, label.Visible, label.TextTransparency = message, true, 0
    task.delay(2, function()
        if current ~= version then return end
        label.Visible = false
    end)
end)

-- Carrying players can put a baby down before switching to their bat.
local function updateDropAction()
    ContextActionService:UnbindAction("DropBaby")
    if player:GetAttribute("CarryingSlime") then
        ContextActionService:BindAction("DropBaby", function(_, state)
            if state == Enum.UserInputState.Begin then remote:FireServer("Drop") end
            return Enum.ContextActionResult.Sink
        end, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonB)
        ContextActionService:SetTitle("DropBaby", "Drop Baby")
        ContextActionService:SetPosition("DropBaby", UDim2.new(1, -160, 1, -170))
    end
end
player:GetAttributeChangedSignal("CarryingSlime"):Connect(updateDropAction)
updateDropAction()
</ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX15">
        <Properties>
          <string name="Name">BatTestDriver</string>
          <ProtectedString name="Source">-- Test-only client. Included solely in Bat-Test.rbxlx.
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local player=Players.LocalPlayer
local control=RS:WaitForChild("BatTestControl")
local swing=RS:WaitForChild("SlimeBatSwing")
control.OnClientEvent:Connect(function(id,action,arg)
    local ok,err=pcall(function()
        local char=player.Character or player.CharacterAdded:Wait()
        local hum=char:WaitForChild("Humanoid")
        if action=="Capture" then
            hum:EquipTool(player.Backpack:FindFirstChild("Slime Grabber") or char:FindFirstChild("Slime Grabber"))
            task.wait(.2)
            local prompt=workspace.SlimeMap.WildSlimes[arg].Body.CapturePrompt
            prompt:InputHoldBegin();task.wait(2.2);prompt:InputHoldEnd();task.wait(.2)
        elseif action=="Pickup" then
            hum:EquipTool(player.Backpack:FindFirstChild("Slime Grabber") or char:FindFirstChild("Slime Grabber"))
            task.wait(.15)
            local prompt=workspace.SlimeMap.WildSlimes[arg].Body.CapturePrompt
            task.wait(.3);prompt:InputHoldBegin();task.wait(.25);prompt:InputHoldEnd();task.wait(.3)
        elseif action=="Begin" then
            hum:EquipTool(player.Backpack:FindFirstChild("Slime Grabber") or char:FindFirstChild("Slime Grabber"))
            task.wait(.15);workspace.SlimeMap.WildSlimes[arg].Body.CapturePrompt:InputHoldBegin();task.wait(.3)
        elseif action=="Release" then
            workspace.SlimeMap.WildSlimes[arg].Body.CapturePrompt:InputHoldEnd()
        elseif action=="Bat" then
            hum:EquipTool(player.Backpack:FindFirstChild("Slime Bat") or char:FindFirstChild("Slime Bat"))
            task.wait(.15)
            char["Slime Bat"]:Activate();task.wait(.15)
        elseif action=="Swing" then swing:FireServer();task.wait(.1)
        elseif action=="Drop" then swing:FireServer("Drop");task.wait(.15)
        elseif action=="Unequip" then hum:UnequipTools();task.wait(.15)
        end
    end)
    control:FireServer(id,ok,err)
end)
control:FireServer("Ready",true)
</ProtectedString>
        </Properties>
      </Item>
